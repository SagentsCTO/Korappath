# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Local originals — keep full-res scans/photos here without committing them
# (move a resized/compressed copy into images/people/ when it's ready for the site)
raw-photos/
originals/

# Temp/backup files
*.bak
*.tmp
~$*
# Comics — real family photos used as references for the image generator.
# NEVER commit these (the repo and site are public).
comics/*/refs/
# Generated character sheets show the kids' likenesses; review before un-ignoring.
comics/*/sheets/

# Comments Worker — local dev secrets and state
workers/*/.dev.vars
workers/*/.wrangler/
# Candidate panel edits awaiting approval
comics/*/review/
# Full-size generated panels before web compression
comics/*/panels/raw/
