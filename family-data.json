    {
      "id": "krc_menon",
      "name": "K.R.C. Menon (Korappath Kalappurakkal Ramachandran Menon)",
      "parentId": "janaki-amma",
      "order": 1,
      "born": "",
      "died": "2008",
      "location": "Chiyyaram",
      "story": "Founder Secretary of the Thrissur Pooram Ekopana Samithy, formed in 1988 to bring the participating temples of the Thrissur Pooram festival under one common platform after many had fallen into decline. He is credited with reviving several ailing or nearly extinct constituent Poorams, secured a significant Kerala Tourism Department grant for the Samithy, and served for decades as President of the Pookkattikkara–Karamukku Kshethra Kshema Samithi. He passed away on 2 July 2008. The K.R.C. Menon Memorial Award is presented annually in his honor by the Thrissur Pooram Ekopana Samithy.",
